# ==========================================
# OPD Connect+ Backend Environment Config
# ==========================================
# WARNING: Do not commit sensitive production secrets to version control.
# Copy this file to .env and provide your actual credentials.

PROJECT_NAME=OPD Connect+
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Bind Settings
HOST=0.0.0.0
PORT=8000

# Security & JWT Configuration
# Generate secure keys via: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase & PostgreSQL Database Configuration
# Supabase Project Ref: xxwidqatsxzsrulaxxal
# Direct connection: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct DB: postgresql://postgres:[password]@db.xxwidqatsxzsrulaxxal.supabase.co:5432/postgres
# Fallback / Local Development SQLite: sqlite:///./opd_connect.db
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.xxwidqatsxzsrulaxxal.supabase.co:5432/postgres

# Supabase API Credentials (Optional direct SDK access)
SUPABASE_URL=https://xxwidqatsxzsrulaxxal.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# File Storage Configuration
STORAGE_BACKEND=local
# Options: local, supabase
STORAGE_LOCAL_DIR=./storage/medical_documents
SUPABASE_STORAGE_BUCKET=medical-documents

# CORS Configuration (Comma separated origins)
CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://localhost:3000", "http://10.0.2.2:8000", "http://127.0.0.1:8000", "*"]
